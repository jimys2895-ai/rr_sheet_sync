# ── RoseRocket (v1.0 API) ────────────────────────────────────────────────────
# ROSEROCKET_ORG_URL       : your org subdomain URL (e.g. https://yourorg.roserocket.com)
# ROSEROCKET_CLIENT_ID     : "Org App Key" UUID from Settings → Org Apps
# ROSEROCKET_CLIENT_SECRET : secret from the key-icon button next to your Org App
# ROSEROCKET_USERNAME      : your RoseRocket login email
# ROSEROCKET_PASSWORD      : your RoseRocket login password
ROSEROCKET_ORG_URL=https://yourorg.roserocket.com
# CE Logistics org — CEL-* Force Deliver + commission report (invoice-sent). CET-* uses ROSEROCKET_ORG_URL above.
ROSEROCKET_CELOGISTICS_ORG_URL=https://celogistics.roserocket.com
ROSEROCKET_CLIENT_ID=your-org-app-key-uuid
ROSEROCKET_CLIENT_SECRET=your-client-secret
ROSEROCKET_USERNAME=you@yourcompany.com
ROSEROCKET_PASSWORD=yourpassword

# Recent date window: pull orders CREATED within the last N days. Default 30 (~1 month).
# Lower this (e.g. 14) if sync is slow and you don't need older orders.
# ROSEROCKET_SINCE_DAYS=30

# Parallel RoseRocket /legs fetches during outbound/inbound sync (default 12). Raise cautiously if API allows.
# ROSEROCKET_LEG_FETCH_CONCURRENCY=12

# Pause between outbound/inbound tab writes to avoid Google Sheets quota errors (default 2000 ms).
# Set to 0 to disable; increase (e.g. 5000) if you see "Rate limit" retries in logs.
# SHEETS_TAB_WRITE_DELAY_MS=2000

# ── Cron / sync scope ────────────────────────────────────────────────────────
# SYNC_SCOPE=full            — outbound + inbound + Force Deliver ops + commission (local dev)
# SYNC_SCOPE=outbound        — outbound sheet only (webhook / main outbound cron / npm run sync:outbound)
# SYNC_SCOPE=inbound         — inbound sheet only (npm run sync:inbound)
# SYNC_SCOPE=commission      — commission sheet only (npm run sync:commission)
# SYNC_SCOPE=ops             — Force Deliver + Force Delete Manifest queues only (npm run sync:ops)
#
# Optional flags when scope includes ops or commission:
# SYNC_INCLUDE_OPS=false           — skip Force Deliver (when scope includes ops)
# SYNC_INCLUDE_COMMISSION=false    — skip commission (full sync only)
# SYNC_INCLUDE_FORCE_DELIVER=false — skip Force Deliver queue
# SYNC_INCLUDE_FORCE_CANCEL=false  — skip Force Cancel queue (cancels orders; PERMANENT)
# SYNC_INCLUDE_FORCE_DELETE_MANIFEST=false — skip Force Delete Manifest queue
#
# The outbound sync writes ONE thing back to RoseRocket: when an outbound manifest (tagged
# OUTBOUND_TRIGGER_TAG) reaches LDT, it auto-adds the INBOUND_TRIGGER_TAG so the inbound pickups
# surface on the inbound sheet. Idempotent; never removes tags. Set to false to disable that write.
# SYNC_AUTO_TAG_INBOUND=false
#
# Render cron jobs (see render.yaml):
#   outbound   (*/5):       SYNC_SCOPE=outbound
#   inbound    (*/5):       SYNC_SCOPE=inbound
#   commission (*/10):      SYNC_SCOPE=commission
#   ops        (0 * * * *): SYNC_SCOPE=ops
#   exchange-rate (0 12 * * 6): npm run sync:exchange-rates — no SYNC_SCOPE, writes to RoseRocket only
#   trip-history  (*/30):       npm run sync:trip-history — archives completed manifests (O/B, I/B, Rounder)
#   (plus the roserocket-sheets-webhook web service for force refresh)
#
# Outbound sheet trigger tag: a manifest gets its own nickname tab only when it carries this
# RoseRocket tag. The US Outbound master still lists every US Outbound order, tagged or not. Tabs are
# named by manifest nickname; the tag is just the on/off switch. Case/space-insensitive. Default "US O/B".
# OUTBOUND_TRIGGER_TAG=US O/B
#
# Commission Lookup pulls CEL orders by created_at; buffer extends that window back from the
# lookup start date so older orders delivered in the period are included. Default 21 days.
# Raise if lookup rows are missing; lower for faster commission sync.
# ROSEROCKET_COMMISSION_LOOKUP_BUFFER_DAYS=21

# The commission sheet does NOT convert currency itself — it reports RoseRocket's own CAD figures,
# which RoseRocket computes from its Exchange Rates table (Settings > Accounting > Exchange rates).
# The exchange-rate cron keeps that table filled from the Bank of Canada FXUSDCAD close (no API key).
# USD_TO_CAD_RATE is only a last-resort fallback for the outbound/inbound sheet Rate. Normally unset.
# USD_TO_CAD_RATE=1.37
# Bank of Canada rates are cached to a temp file to avoid re-fetching the same day. Defaults to the OS
# temp dir (cleared on reboot). Set FX_CACHE_FILE to a persistent path/volume to reuse across runs.
# FX_CACHE_FILE=/var/data/fxusdcad-cache.json

# Optional hard safety cap on rows fetched (0/unset = unlimited; the date window is the real bound).
# ROSEROCKET_MAX_ORDERS=5000

# Optional overrides — defaults are correct for this org, so normally leave unset:
# ROSEROCKET_TOKEN_URL=https://yourorg.roserocket.com/api/v1/sessions
# ROSEROCKET_BASE_URL=https://network.roserocket.com
# ROSEROCKET_PLATFORM_URL=https://platform.roserocket.com
# ROSEROCKET_WEB_URL — base for the clickable Order/Manifest links in the US Outbound tab.
#   Defaults to ROSEROCKET_ORG_URL (e.g. https://yourorg.roserocket.com).
# ROSEROCKET_WEB_URL=https://yourorg.roserocket.com

# ── Google Sheets ────────────────────────────────────────────────────────────
# GOOGLE_OUTBOUND_SHEET_ID : REQUIRED. The target spreadsheet's ID (or full URL). Without it,
#                   each run creates a brand-new empty sheet on serverless hosts.
GOOGLE_OUTBOUND_SHEET_ID=your-google-outbound-sheet-id-or-url

# Inbound spreadsheet — same layout as the outbound sheet, but "US Inbound" (orders originating in the
# USA) and the "US I/B" nickname trigger tag. Used by the inbound cron (SYNC_SCOPE=inbound).
GOOGLE_INBOUND_SHEET_ID=your-google-inbound-sheet-id-or-url

# Optional overrides for the nickname-tab trigger tags (defaults shown).
# OUTBOUND_TRIGGER_TAG=US O/B
# INBOUND_TRIGGER_TAG=US I/B

# Ops spreadsheet (Force Deliver + Force Cancel + Force Delete Manifest queues).
GOOGLE_OPS_SHEET_ID=your-google-ops-sheet-id-or-url

# Trip-history spreadsheet — append-only archive of completed manifests (tabs O/B, I/B, Rounder), used
# by the trip-history cron (npm run sync:trip-history). The service account must have Editor access.
# A trip is archived when it is FINISHED and either (a) carries a US->CA order, or (b) carries the
# OUTBOUND_TRIGGER_TAG / INBOUND_TRIGGER_TAG — the tag is a manual override that forces a manifest onto
# the archive whatever its shape. No nickname is needed either way.
GOOGLE_TRIP_HISTORY_SHEET_ID=your-google-trip-history-sheet-id-or-url

# How far back the trip-history cron looks for newly finished trips. Default 60 days.
# TRIP_HISTORY_SINCE_DAYS=60

# Default start date for the ONE-OFF backfill (npm run trip-history:backfill). Not used by the cron —
# reaching this far back is far too heavy to run every 30 minutes. Override per run:
#   npm run trip-history:backfill -- 2026-03-01
# TRIP_HISTORY_BACKFILL_FROM=2026-01-01
# Rows written per batch during the backfill, so a long run is durable and resumable. Default 25.
# TRIP_HISTORY_BACKFILL_FLUSH=25

# Commission spreadsheet (All Commission, rep tabs, Commission Lookup).
GOOGLE_COMMISSION_SHEET_ID=your-google-commission-sheet-id-or-url

# ── Outbound sheet force refresh (webhook) ───────────────────────────────────
# Shared secret for POST /refresh/outbound (Apps Script sends Authorization: Bearer …).
# Generate a long random string. Required for the Render web service (npm start).
# SYNC_WEBHOOK_SECRET=your-long-random-secret
# PORT=3000   # optional locally; Render sets PORT automatically

# Provide the service-account credentials in ONE of two ways:
#   (A) A path to the JSON key file — local dev, or a Render "Secret File":
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./credentials/google-service-account.json
#   (B) OR the full JSON inline (paste the file's contents). Takes priority if set:
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"..."}
